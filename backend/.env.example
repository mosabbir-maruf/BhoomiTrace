# BhoomiTrace backend example environment

# Runtime environment (development | test | production)
NODE_ENV=development

# Server interface and port
HOST=0.0.0.0
PORT=3000

# Logging level (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Development database connection
DATABASE_URL=postgres://bhoomitrace:bhoomitrace@127.0.0.1:5433/bhoomitrace

# Integration test database connection
TEST_DATABASE_URL=postgres://bhoomitrace:bhoomitrace@127.0.0.1:5433/bhoomitrace_test

# Connection pool tuning
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# Authentication configuration

# Login session lifetime in hours
AUTH_SESSION_TTL_HOURS=12

# Rate limiting per client address and route
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Session cookie secure flag for HTTPS
# COOKIE_SECURE=false

# Allowed cross-origin browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trust X-Forwarded-* headers when behind a proxy
TRUST_PROXY=false

# Uploaded evidence configuration

# Private storage path for uploaded files
UPLOAD_DIR=./.local-storage/uploads

# Maximum upload size in bytes (5 MiB default)
UPLOAD_MAX_BYTES=5242880

# Extraction provider configuration

# Provider implementation (mock | gemini | groq | auto)
EXTRACTION_PROVIDER=mock

EXTRACTION_TIMEOUT_MS=30000

# Maximum document content sent inline to an external reader in bytes
EXTRACTION_MAX_CONTENT_BYTES=5242880

# Gemini external reader credentials and model
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq vision-capable model credentials and model
# GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Background worker configuration

# Lease staleness bound before recovery; renewed while running, not an execution limit
WORKER_LEASE_SECONDS=60

# Maximum attempts before marking a job failed
WORKER_MAX_ATTEMPTS=3

# Initial retry backoff in seconds (doubles each attempt)
WORKER_RETRY_BACKOFF_SECONDS=5

# Idle polling interval in milliseconds
WORKER_POLL_INTERVAL_MS=1000
