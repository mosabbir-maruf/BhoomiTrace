# ---------------------------------------------------------------------------
# BhoomiTrace backend — example environment.
#
# Copy to `.env` for local development:  cp .env.example .env
# The values below are throwaway local-only defaults that match the Compose
# PostgreSQL service in ../docker-compose.yml. Never commit real credentials.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Interface and port the Fastify server binds to.
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Connection used by the application (development database).
DATABASE_URL=postgres://bhoomitrace:bhoomitrace@127.0.0.1:5433/bhoomitrace

# Connection used by integration tests (separate database, same instance).
TEST_DATABASE_URL=postgres://bhoomitrace:bhoomitrace@127.0.0.1:5433/bhoomitrace_test

# Connection pool tuning.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
