# ---------------------------------------------------------------------------
# BhoomiTrace backend — example environment.
#
# Copy to `.env` for local development:  cp .env.example .env
# The values below are throwaway local-only defaults that match the Compose
# PostgreSQL service in ../docker-compose.yml. Never commit real credentials.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Interface and port the Fastify server binds to.
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Connection used by the application (development database).
DATABASE_URL=postgres://bhoomitrace:bhoomitrace@127.0.0.1:5433/bhoomitrace

# Connection used by integration tests (separate database, same instance).
TEST_DATABASE_URL=postgres://bhoomitrace:bhoomitrace@127.0.0.1:5433/bhoomitrace_test

# Connection pool tuning.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Lifetime of a login session.
AUTH_SESSION_TTL_HOURS=12

# Requests allowed per window against the authentication endpoints, per client
# address and per route. The window is separate from the count.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Set to true only when the API is served over HTTPS; it adds `Secure` to the
# session cookie. Left unset, it follows NODE_ENV (off in development, on in
# production).
# COOKIE_SECURE=false

# Origins allowed to call this API from a browser, comma separated. An exact
# list, never `*`: these origins are also the ones permitted to send
# state-changing requests. Leave empty to disable cross-origin browser access.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trust `X-Forwarded-*` headers. Keep false unless a reverse proxy in front of
# this process is configured to strip and rewrite them.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Uploaded evidence
# ---------------------------------------------------------------------------

# Private, git-ignored storage for uploaded files. Never inside a public
# directory, and never committed.
UPLOAD_DIR=./.local-storage/uploads

# Largest accepted upload, in bytes. Default 5 MiB.
UPLOAD_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# Extraction
# ---------------------------------------------------------------------------

# mock | gemini | groq | auto
#
# `mock` is a deterministic test double, not a reader: it returns only fixtures
# it was constructed with and marks everything else unclear, and it is reported
# as such on every job result. `auto` builds the Gemini-primary / Groq-fallback
# chain. The external readers are handed the stored document itself; a record
# with no stored file is refused rather than answered from its metadata.
EXTRACTION_PROVIDER=mock

EXTRACTION_TIMEOUT_MS=30000

# Largest document sent inline to an external reader, in bytes. Bounded by the
# vendors' ~20 MB inline ceiling, and it must be at least UPLOAD_MAX_BYTES or a
# file the platform accepted could not be read back.
EXTRACTION_MAX_CONTENT_BYTES=5242880

# Credentials for the external readers. Never commit real values.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GROQ_API_KEY=
# Must be a vision-capable model. A text-only model answers from the prompt
# rather than the document, so known text-only values (such as
# openai/gpt-oss-20b) are refused at startup with an actionable message.
GROQ_MODEL=qwen/qwen3.8-27b

# ---------------------------------------------------------------------------
# Background worker (`npm run worker`)
# ---------------------------------------------------------------------------

# How long a claimed job is leased before another worker may reclaim it.
WORKER_LEASE_SECONDS=60

# Attempts before a job is marked failed.
WORKER_MAX_ATTEMPTS=3

# Delay before the first retry; doubles on each subsequent attempt.
WORKER_RETRY_BACKOFF_SECONDS=5

# Idle poll interval when the queue is empty.
WORKER_POLL_INTERVAL_MS=1000
