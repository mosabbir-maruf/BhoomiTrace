# BhoomiTrace repository-wide ignore rules

# macOS
.DS_Store

# Node and TypeScript
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.pnpm-store/

# Local private storage for uploaded evidence
.local-storage/

# Environment files and templates
.env
.env.*
!.env.example
!**/.env.example

# Logs, caches, and temporary files
*.log
logs/
.cache/
.tmp-*
*.pid

# Production deployment runtime state; never commit
deploy/env/stack.env
deploy/env/secrets.env
deploy/state/
deploy/backups/
deploy/.verify/

# Local database data
.docker-data/
pgdata/

# Frontend build outputs and local caches
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.vite/

# Agent instructions and case variants
CLAUDE.md
claude.md
Claude.md
[Cc][Ll][Aa][Uu][Dd][Ee].md
[Cc][Ll][Aa][Uu][Dd][Ee].*.md
*.[Cc][Ll][Aa][Uu][Dd][Ee].md

# Agent instructions and case variants
AGENTS.md
agents.md
Agents.md
agentm.md
AGENTM.md
[Aa][Gg][Ee][Nn][Tt][Ss].md
[Aa][Gg][Ee][Nn][Tt][Mm].md
[Aa][Gg][Ee][Nn][Tt][Ss].*.md
[Aa][Gg][Ee][Nn][Tt][Mm].*.md

# Private agent configurations, skills, and metadata
.agent/
.agents/
.claude/
.claude-replay.*
.cursor/
.cursorrules
.gemini/
.impeccable/
.opencode-skills/
.plugins/
skills/
skills-lock.json
/.figma/design-context/
