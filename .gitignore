# ---------------------------------------------------------------------------
# BhoomiTrace — repository-wide ignore rules
# ---------------------------------------------------------------------------

# macOS
.DS_Store

# Node / TypeScript
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.pnpm-store/

# Local private storage for uploaded evidence. Uploaded files and their
# contents are never committed, never logged, and never snapshotted.
.local-storage/

# Environment files — never commit real values. Keep the *.example templates.
.env
.env.*
!.env.example
!**/.env.example

# Logs, caches, temporary files
*.log
logs/
.cache/
.tmp-*
*.pid

# Local database data (Docker named volumes live outside the repo; this guards
# bind-mounted directories if one is ever added).
.docker-data/
pgdata/

# ---------------------------------------------------------------------------
# Existing Figma Make frontend scaffold
# ---------------------------------------------------------------------------
# `frontend/` is a pre-existing Figma Make export that is NOT part of version
# control. It is tracked separately when the frontend track begins. It must
# never be committed from a backend branch, so it is ignored here.
/frontend/

# ---------------------------------------------------------------------------
# Agent instructions, configurations, skills & metadata — never committed
# ---------------------------------------------------------------------------
# Claude instructions and case variants
CLAUDE.md
claude.md
Claude.md
[Cc][Ll][Aa][Uu][Dd][Ee].md
[Cc][Ll][Aa][Uu][Dd][Ee].*.md
*.[Cc][Ll][Aa][Uu][Dd][Ee].md

# Agent instructions and case variants
AGENTS.md
agents.md
Agents.md
agentm.md
AGENTM.md
[Aa][Gg][Ee][Nn][Tt][Ss].md
[Aa][Gg][Ee][Nn][Tt][Mm].md
[Aa][Gg][Ee][Nn][Tt][Ss].*.md
[Aa][Gg][Ee][Nn][Tt][Mm].*.md

# Private agent configuration and skill directories/files
.agent/
.agents/
.claude/
.claude-replay.*
.cursor/
.cursorrules
.gemini/
.impeccable/
.opencode-skills/
.plugins/
skills/
skills-lock.json
/.figma/design-context/
