# BhoomiTrace production secrets — TEMPLATE ONLY
#
# Do NOT copy the values below into use. This file documents the shape of
# deploy/env/secrets.env, which is generated on the host by:
#
#   sudo deploy/scripts/fetch-secrets.sh
#
# fetch-secrets.sh reads a JSON secret from AWS SSM Parameter Store or Secrets
# Manager using the EC2 instance role, validates it, and writes the result with
# mode 0600. Real values are never committed, never printed, and never passed on
# a command line.
#
# The JSON object stored in AWS has exactly this shape:
#
#   {
#     "POSTGRES_PASSWORD": "<32+ hex characters>",
#     "GEMINI_API_KEY": "",      # only when EXTRACTION_PROVIDER=gemini/auto
#     "GROQ_API_KEY": ""         # only when EXTRACTION_PROVIDER=groq/auto
#   }
#
# POSTGRES_PASSWORD must be URL-safe ([A-Za-z0-9._~-]) because it is embedded in
# DATABASE_URL. Generate it with: openssl rand -hex 32

POSTGRES_PASSWORD=REPLACE_ME
