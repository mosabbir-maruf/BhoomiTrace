# BhoomiTrace production stack configuration — TEMPLATE
#
# Copy to deploy/env/stack.env and edit. This file holds NO secrets: the only
# credential the stack needs (the PostgreSQL password) lives in
# deploy/env/secrets.env, which is generated by scripts/fetch-secrets.sh from
# AWS SSM Parameter Store or Secrets Manager and is never committed.
#
#   cp deploy/env/stack.env.example deploy/env/stack.env
#   chmod 600 deploy/env/stack.env

# ---------------------------------------------------------------------------
# Host paths — all on the dedicated EBS data volume
# ---------------------------------------------------------------------------
# The mount point of the EBS volume that holds the database, evidence, backups,
# and TLS material. prepare-host.sh verifies this is a real mount (not the root
# filesystem) before it creates anything.
BHOOMITRACE_DATA_DIR=/srv/bhoomitrace
# Flat certificate pair (fullchain.pem + privkey.pem), mode 0700 root-owned
BHOOMITRACE_TLS_DIR=/srv/bhoomitrace/tls
# Local staging directory for dumps and tarballs before/after S3 upload
BHOOMITRACE_BACKUP_DIR=/srv/bhoomitrace/backups
# Recorded image references and deployment metadata (rollback reads this)
BHOOMITRACE_STATE_DIR=/srv/bhoomitrace/state

# ---------------------------------------------------------------------------
# Public identity
# ---------------------------------------------------------------------------
# The exact hostname served by the edge proxy. Must resolve to this host's
# public address and must match the certificate's name.
DOMAIN=bhoomitrace.example.org
# EXACTLY the https origin of that hostname: no wildcard, no path, no trailing
# slash, no http:// entry. A mismatch makes every state-changing request fail
# with 403 (the API requires the browser Origin to be on this list).
CORS_ALLOWED_ORIGINS=https://bhoomitrace.example.org

# ---------------------------------------------------------------------------
# Edge proxy published ports (defaults are correct for production)
# ---------------------------------------------------------------------------
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Container images — MUST be immutable (full-SHA tag or digest)
# ---------------------------------------------------------------------------
# preflight.sh refuses `latest` and any mutable tag. Set both to the full
# sha-<40 hex> tag produced by .github/workflows/publish-image.yml, or to a
# @sha256:<digest> reference. Record what is currently deployed with
# scripts/record-release.sh before changing these.
BACKEND_IMAGE=ghcr.io/OWNER/bhoomitrace-backend:sha-0000000000000000000000000000000000000000
FRONTEND_IMAGE=ghcr.io/OWNER/bhoomitrace-frontend:sha-0000000000000000000000000000000000000000
# Pin the base/pull-through images to a digest where your supply chain requires it
POSTGRES_IMAGE=postgres:17-alpine
EDGE_IMAGE=nginx:1.30.6-alpine

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=bhoomitrace
POSTGRES_DB=bhoomitrace
# POSTGRES_PASSWORD is intentionally absent: it belongs in secrets.env.
# These must match the images in use (verified against postgres:17-alpine and
# node:24-bookworm-slim); prepare-host.sh uses them for directory ownership.
POSTGRES_UID=70
UPLOAD_UID=1000

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# S3 bucket that receives database dumps and evidence tarballs. Leave empty only
# if you deliberately run backups without off-host copies — backup scripts fail
# rather than silently skipping the upload when this is unset.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=bhoomitrace
# aws:kms (default) requires a KMS key; use AES256 if you have no KMS key.
BACKUP_S3_SSE=aws:kms
# Leave empty to use the bucket's default KMS key
BACKUP_S3_KMS_KEY_ID=
BACKUP_S3_STORAGE_CLASS=STANDARD_IA
# Days after which S3 lifecycle removes backup objects (also applied by
# scripts/configure-s3-lifecycle.sh)
BACKUP_RETENTION_DAYS=30
# Days to keep local staged copies on the EBS volume
BACKUP_LOCAL_RETENTION_DAYS=7
AWS_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Application tuning (safe defaults; change only with a reason)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
DATABASE_POOL_MAX=10
WORKER_DATABASE_POOL_MAX=5
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=5
WORKER_POLL_INTERVAL_MS=1000
AUTH_SESSION_TTL_HOURS=12
UPLOAD_MAX_BYTES=5242880
EXTRACTION_MAX_CONTENT_BYTES=5242880

# Extraction provider for the worker.
# `mock` is offline, deterministic, and needs no credentials — the correct
# choice for a synthetic-data demo. Switching to gemini/groq additionally
# requires the corresponding API key in secrets.env.
EXTRACTION_PROVIDER=mock
