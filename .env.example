# ---------------------------------------------------------------------------
# Docker Compose environment for the local development database.
#
# Copy to `.env` for local development. These are throwaway local-only
# credentials for a containerised PostgreSQL instance; they are NOT secrets for
# any deployed environment. Never put real credentials in this file.
# ---------------------------------------------------------------------------

# Host port the local PostgreSQL container is published on. Chosen to avoid
# clashing with a 5432 instance that may already exist on the workstation.
POSTGRES_HOST_PORT=5433

POSTGRES_USER=bhoomitrace
POSTGRES_PASSWORD=bhoomitrace
POSTGRES_DB=bhoomitrace

# Name of the extra database created for integration tests.
POSTGRES_TEST_DB=bhoomitrace_test
