# Local development credentials for Docker Compose; never use as deployment secrets

# PostgreSQL container configuration

# Host port published to avoid clashing with host PostgreSQL on 5432 (bound to 127.0.0.1 only)
POSTGRES_HOST_PORT=5433

POSTGRES_USER=bhoomitrace
POSTGRES_PASSWORD=bhoomitrace
POSTGRES_DB=bhoomitrace

# Extra database created for integration tests
POSTGRES_TEST_DB=bhoomitrace_test

# Backend application stack configuration (api / worker / migrate)

# Host port for the API (published on 127.0.0.1 only)
API_HOST_PORT=3000

# API connection pool size
DATABASE_POOL_MAX=10

# Logging level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Exact browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Extraction provider used by worker (mock | gemini | groq | auto)
EXTRACTION_PROVIDER=mock

# Background worker tuning

# Lease staleness bound before recovery; renewed while running, not an execution limit
WORKER_LEASE_SECONDS=60

# Attempts before a job is marked permanently failed
WORKER_MAX_ATTEMPTS=3

# Delay before the first retry (doubles on each subsequent attempt)
WORKER_RETRY_BACKOFF_SECONDS=5

# Idle poll interval in milliseconds when queue is empty
WORKER_POLL_INTERVAL_MS=1000

# Worker connection pool size (smaller than the API pool)
WORKER_DATABASE_POOL_MAX=5
